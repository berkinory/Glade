{
  "name": "@glade/monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "scripts"
    ],
    "catalog": {
      "effect": "4.0.0-beta.25",
      "@effect/platform-node": "4.0.0-beta.25",
      "@effect/sql-sqlite-bun": "4.0.0-beta.25",
      "@effect/vitest": "4.0.0-beta.25",
      "@effect/language-service": "0.75.1",
      "@types/bun": "^1.4.1",
      "@types/node": "^24.10.13",
      "tsdown": "^0.20.3",
      "typescript": "^5.7.3",
      "vitest": "^4.1.10"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev-runner.ts dev:desktop",
    "dev:stop": "bun scripts/dev-stop.ts",
    "start": "turbo run start --filter=@glade/cli",
    "build": "turbo run build",
    "build:desktop": "turbo run build --filter=@glade/desktop --filter=@glade/cli",
    "postinstall": "effect-tsgo patch --typescript --typescript-package @typescript/native",
    "check": "oxfmt --check && oxlint --report-unused-disable-directives --deny-warnings && bun run check:architecture && effect-tsgo patch --typescript --typescript-package @typescript/native && turbo run typecheck",
    "check:fix": "oxfmt && oxlint --fix --report-unused-disable-directives --deny-warnings && bun run check",
    "test": "turbo run test",
    "package:mac:arm64": "node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch arm64",
    "package:mac:x64": "node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch x64",
    "package:linux": "node scripts/build-desktop-artifact.ts --platform linux --target AppImage --arch x64",
    "package:win": "node scripts/build-desktop-artifact.ts --platform win --target nsis --arch x64",
    "check:architecture": "bun scripts/checks/moduleBoundaries.ts && knip"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "0.41.0",
    "@types/node": "catalog:",
    "@typescript/native": "npm:typescript@7.0.2",
    "knip": "6.38.0",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "turbo": "^2.9.14",
    "vitest": "catalog:"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-beta.25",
    "ip-address": "^10.7.1"
  },
  "engines": {
    "bun": "^1.4.2",
    "node": "^24.13.1"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@legendapp/list@3.3.3": "patches/@legendapp%2Flist@3.3.3.patch",
    "@pierre/diffs@1.3.5": "patches/@pierre%2Fdiffs@1.3.5.patch",
    "@effect/platform-node-shared@4.0.0-beta.25": "patches/@effect%2Fplatform-node-shared@4.0.0-beta.25.patch"
  }
}
