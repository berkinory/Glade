{
  "name": "@glade/monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "scripts"
    ],
    "catalog": {
      "effect": "https://pkg.pr.new/Effect-TS/effect-smol/effect@8881a9b",
      "@effect/platform-node": "https://pkg.pr.new/Effect-TS/effect-smol/@effect/platform-node@8881a9b",
      "@effect/sql-sqlite-bun": "https://pkg.pr.new/Effect-TS/effect-smol/@effect/sql-sqlite-bun@8881a9b",
      "@effect/vitest": "https://pkg.pr.new/Effect-TS/effect-smol/@effect/vitest@8881a9b",
      "@effect/language-service": "0.75.1",
      "@types/bun": "^1.4.1",
      "@types/node": "^24.10.13",
      "tsdown": "^0.20.3",
      "typescript": "^5.7.3",
      "vitest": "^4.1.10"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev-runner.ts dev:desktop",
    "dev:stop": "bun scripts/dev-stop.ts",
    "start": "turbo run start --filter=@glade/cli",
    "build": "turbo run build",
    "build:desktop": "turbo run build --filter=@glade/desktop --filter=@glade/cli",
    "postinstall": "effect-tsgo patch --typescript --typescript-package @typescript/native",
    "check": "oxfmt --check && oxlint --report-unused-disable-directives && effect-tsgo patch --typescript --typescript-package @typescript/native && turbo run typecheck",
    "check:fix": "oxfmt && oxlint --fix --report-unused-disable-directives && bun run check",
    "test": "turbo run test",
    "package:mac:arm64": "node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch arm64",
    "package:mac:x64": "node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch x64",
    "package:linux": "node scripts/build-desktop-artifact.ts --platform linux --target AppImage --arch x64",
    "package:win": "node scripts/build-desktop-artifact.ts --platform win --target nsis --arch x64"
  },
  "devDependencies": {
    "@effect/tsgo": "0.41.0",
    "@types/node": "catalog:",
    "@typescript/native": "npm:typescript@7.0.2",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "turbo": "^2.9.14",
    "vitest": "catalog:"
  },
  "overrides": {
    "axios": "^1.16.0",
    "defu": "^6.1.5",
    "fast-uri": "^3.1.2",
    "follow-redirects": "^1.16.0",
    "form-data": "^4.0.6",
    "hono": "^4.12.25",
    "ip-address": "^10.2.0",
    "joi": "^18.2.1",
    "lodash": "^4.18.1",
    "postcss": "^8.5.10",
    "protobufjs": "^7.6.3",
    "qs": "^6.15.2",
    "smol-toml": "^1.6.1",
    "uuid": "^13.0.1",
    "vite": "^8.1.4",
    "ws": "^8.21.0",
    "yaml": "^2.8.3"
  },
  "engines": {
    "bun": "^1.4.2",
    "node": "^24.13.1"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@effect/platform-node-shared@https://pkg.pr.new/Effect-TS/effect-smol/@effect/platform-node-shared@8881a9b606d84a6f5eb6615279138322984f5368": "patches/@effect%2Fplatform-node-shared@8881a9b.patch",
    "@legendapp/list@3.3.3": "patches/@legendapp%2Flist@3.3.3.patch",
    "@pierre/diffs@1.3.5": "patches/@pierre%2Fdiffs@1.3.5.patch",
    "betterwright@2.7.3": "patches/betterwright@2.7.3.patch"
  }
}
