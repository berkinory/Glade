{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "types": ["node", "bun"],
    "lib": ["ES2023", "esnext.disposable"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  // Tooling imports production boundaries so checks exercise the actual runtime policy.
  "include": [
    "**/*.ts",
    "../apps/server/src/device/helperSandbox.ts",
    "../apps/server/src/server/cliFlags.ts",
    "../apps/desktop/src/main/updates/windowsCertificate.ts",
    "../apps/desktop/src/desktopAppIcon.ts",
    "../apps/web/src/assets/gladeMark.ts"
  ]
}
