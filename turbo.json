{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "AZURE_TRUSTED_SIGNING_SUBJECT_DN",
    "PORT",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "ELECTRON_RENDERER_PORT",
    "GLADE_HOME",
    "GLADE_DESKTOP_WS_URL",
    "GLADE_BROWSER_HOST_PIPE_PATH",
    "GLADE_BROWSER_USE_PIPE_PATH",
    "GLADE_BROWSER_PERF",
    "GLADE_PROVIDER_RUNTIME_IDLE_STOP_MS",
    "GLADE_WEB_SOURCEMAP",
    "GLADE_SERVER_SOURCEMAP",
    "GLADE_DESKTOP_SOURCEMAP",
    "GLADE_MODE",
    "GLADE_PORT",
    "GLADE_NO_BROWSER",
    "GLADE_AUTH_TOKEN",
    "GLADE_PUBLIC_URL",
    "GLADE_ALLOW_INSECURE_REMOTE",
    "GLADE_LOG_WS_EVENTS",
    "GLADE_HOST",
    "GLADE_AUTO_BOOTSTRAP_PROJECT_FROM_CWD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**", "native-dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "cache": false,
      "outputs": []
    }
  }
}
