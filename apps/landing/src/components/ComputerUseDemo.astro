---
import { Picture } from "astro:assets";
import horizon from "../assets/images/art-horizon.webp";
import Icon from "./Icon.astro";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
const navItems = ["Overview", "Customers", "Releases", "Billing", "Settings"];
---

<figure class="demo" data-demo>
  <div class="stage" data-demo-stage role="img" aria-label={caption}>
    <Picture
      pictureAttributes={{ class: "wall" }}
      src={horizon}
      alt="Misty valley engraving used as the desktop background."
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={[640, 960, 1280, 1920]}
      sizes="(max-width: 1240px) 100vw, 1200px"
      quality={56}
    />
    <div class="window" aria-hidden="true">
      <div class="titlebar">
        <span class="lights"><i></i><i></i><i></i></span>
        <span>Atlas</span>
      </div>
      <div class="body">
        <nav>
          {
            navItems.map((item) => (
              <span class:list={{ on: item === "Releases" }}>
                <i />
                {item}
              </span>
            ))
          }
        </nav>
        <div class="main">
          <p class="h">New release</p>
          <p class="sub">Ship a version to Atlas customers.</p>
          <div class="card">
            <div class="row">
              <div><b>Version</b><small>Semantic version</small></div>
              <span class="field" data-part="version">
                <span data-text></span><span class="caret"></span>
                <span class="placeholder">e.g. 2.4.0</span>
              </span>
            </div>
            <div class="row">
              <div><b>Channel</b><small>Who gets it first</small></div>
              <span class="segment" data-part="channel" data-value="stable">
                <span class="thumb"></span>
                <span data-part="beta">Beta</span>
                <span>Stable</span>
              </span>
            </div>
            <div class="row">
              <div><b>Release notes</b><small>Shown in the app</small></div>
              <span class="field area" data-part="notes">
                <span data-text></span><span class="caret"></span>
                <span class="placeholder">What changed?</span>
              </span>
            </div>
            <div class="row">
              <div><b>Notify customers</b><small>Email and in-app banner</small></div>
              <span class="switch" data-part="notify" aria-checked="false"></span>
            </div>
          </div>
          <div class="bar">
            <span class="status"><span class="draft">Draft</span><span class="done">Published 2.4.0</span></span>
            <span class="publish" data-part="publish">Publish release</span>
          </div>
        </div>
      </div>
      <div class="toast"><Icon name="check" size={14} /> v2.4.0 published</div>
    </div>

    <div class="cursor" data-demo-cursor aria-hidden="true">
      <span class="ticks"><i></i><i></i><i></i></span>
      <svg class="arrow" viewBox="0 0 32 32" width="30" height="30">
        <path
          d="M5.4 4.2 27.2 13.6c1.6.7 1.5 3-.2 3.5l-8.6 2.6c-.6.2-1 .6-1.2 1.2l-3.1 8.4c-.6 1.6-2.9 1.6-3.4 0L4 6.3c-.4-1.3.9-2.6 2.2-2.1Z"
          fill="#c77dff"
          stroke="#fff"
          stroke-width="2.4"
          stroke-linejoin="round"></path>
      </svg>
      <span class="badge">
        <span class="chip"><Icon name="window" size={13} /></span>
        <span class="pill">
          <span class="name">Glade-a982923</span>
          <span class="square filled"><Icon name="copy" size={12} /></span>
          <span class="square">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
              <path d="M4 9V5a1 1 0 0 1 1-1h4M15 4h4a1 1 0 0 1 1 1v4M20 15v4a1 1 0 0 1-1 1h-4M9 20H5a1 1 0 0 1-1-1v-4"></path>
            </svg>
          </span>
        </span>
      </span>
    </div>
  </div>

  <span class="label" aria-hidden="true"><i></i>Computer Use</span>
  <button
    type="button"
    class="toggle"
    data-demo-toggle
    data-playing="true"
    aria-label="Pause the animation"
  >
    <Icon name="pause" size={16} class="pause-icon" />
    <Icon name="play" size={16} class="play-icon" />
  </button>
</figure>

<script>
  import { mountComputerUseDemo } from "../scripts/computerUseDemo";
  for (const root of document.querySelectorAll<HTMLElement>("[data-demo]")) {
    mountComputerUseDemo(root);
  }
</script>

<style>
  .demo {
    position: relative;
    margin: 0;
    aspect-ratio: 1200 / 740;
    overflow: hidden;
    border-radius: 16px;
    background: #121214;
    box-shadow:
      0 0 0 1px rgb(147 135 224 / 0.25),
      0 40px 90px rgb(0 0 0 / 0.7);
    container-type: inline-size;
  }
  /* Laid out once at 1200 by 740 and scaled as a whole, so text and spacing keep their proportions. */
  .stage {
    position: absolute;
    top: 0;
    left: 0;
    width: 1200px;
    height: 740px;
    transform: scale(var(--scale, 1));
    transform-origin: 0 0;
    font: 13px/1.45 var(--sans);
    color: #1d1c22;
    -webkit-user-select: none;
    user-select: none;
  }
  .stage :global(.wall),
  .stage :global(.wall img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 32%;
  }
  .stage :global(.wall img) {
    filter: brightness(0.62) contrast(1.05);
  }
  .stage::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 60% at 50% 50%, transparent, rgb(9 9 10 / 0.55));
    pointer-events: none;
  }
  .window {
    position: absolute;
    top: 120px;
    left: 230px;
    z-index: 1;
    width: 740px;
    height: 500px;
    overflow: hidden;
    border-radius: 12px;
    background: #f7f6f3;
    box-shadow:
      0 0 0 0.5px rgb(0 0 0 / 0.5),
      0 1px 0 rgb(255 255 255 / 0.7) inset,
      0 30px 80px rgb(0 0 0 / 0.55);
  }
  .titlebar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    border-bottom: 1px solid #e9e7e2;
    background: #fbfaf8;
    font-weight: 600;
    color: #5a5866;
  }
  .lights {
    position: absolute;
    top: 16px;
    left: 16px;
    display: flex;
    gap: 8px;
  }
  .lights i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ff5f57;
  }
  .lights i:nth-child(2) {
    background: #febc2e;
  }
  .lights i:nth-child(3) {
    background: #28c840;
  }
  .body {
    display: flex;
    height: calc(100% - 44px);
  }
  nav {
    display: grid;
    align-content: start;
    gap: 2px;
    width: 176px;
    padding: 14px 10px;
    border-right: 1px solid #ecebe6;
    background: #f3f2ee;
  }
  nav span {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 7px 10px;
    border-radius: 8px;
    color: #5a5866;
  }
  nav span.on {
    background: #e7e5df;
    color: #1d1c22;
    font-weight: 500;
  }
  nav i {
    width: 13px;
    height: 13px;
    border: 1.5px solid currentColor;
    border-radius: 4px;
    opacity: 0.55;
  }
  .main {
    flex: 1;
    padding: 24px 28px;
    transition: opacity 360ms ease;
  }
  .stage[data-resetting] .main {
    opacity: 0;
  }
  .h {
    margin: 0;
    font-size: 19px;
    font-weight: 650;
    letter-spacing: -0.2px;
  }
  .sub {
    margin: 3px 0 18px;
    color: #7a7884;
  }
  .card {
    padding: 2px 18px;
    border: 1px solid #e7e5e0;
    border-radius: 12px;
    background: #fff;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 250px;
    align-items: center;
    gap: 16px;
    min-height: 58px;
    border-top: 1px solid #f0efea;
  }
  .row:first-child {
    border-top: 0;
  }
  .row:nth-child(3) {
    min-height: 88px;
  }
  .row b {
    display: block;
    font-weight: 500;
  }
  .row small {
    display: block;
    font-size: 12px;
    color: #8a8894;
  }
  .field {
    position: relative;
    display: flex;
    align-items: center;
    height: 32px;
    padding: 0 10px;
    border: 1px solid #dcdad4;
    border-radius: 8px;
    background: #fff;
    white-space: nowrap;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease;
  }
  .field.area {
    align-items: flex-start;
    height: 64px;
    padding-top: 7px;
    white-space: normal;
  }
  .field[data-focused] {
    border-color: #5d50bd;
    box-shadow: 0 0 0 3px rgb(93 80 189 / 0.16);
  }
  .placeholder {
    position: absolute;
    left: 10px;
    top: 50%;
    translate: 0 -50%;
    color: #a3a1ab;
  }
  .area .placeholder {
    top: 7px;
    translate: none;
  }
  .field[data-filled] .placeholder {
    opacity: 0;
  }
  .caret {
    display: none;
    width: 1px;
    height: 16px;
    margin-left: 1px;
    background: #1d1c22;
  }
  .field[data-focused] .caret {
    display: inline-block;
    animation: blink 1s steps(1) infinite;
  }
  .area .caret {
    display: none;
  }
  .area[data-focused] [data-text]::after {
    content: "";
    display: inline-block;
    width: 1px;
    height: 15px;
    margin-left: 1px;
    vertical-align: -2px;
    background: #1d1c22;
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .segment {
    position: relative;
    display: inline-grid;
    grid-template-columns: 64px 64px;
    width: max-content;
    padding: 2px;
    border-radius: 9px;
    background: #efeee9;
  }
  .segment span:not(.thumb) {
    position: relative;
    z-index: 1;
    padding: 5px 0;
    text-align: center;
    color: #6a6874;
    transition: color 200ms ease;
  }
  .thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 64px;
    height: calc(100% - 4px);
    border-radius: 7px;
    background: #fff;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.14);
    translate: 64px 0;
    transition: translate 280ms var(--ease-out);
  }
  .segment[data-value="beta"] .thumb {
    translate: 0 0;
  }
  .segment[data-value="stable"] span:last-child,
  .segment[data-value="beta"] [data-part="beta"] {
    color: #1d1c22;
    font-weight: 500;
  }
  .switch {
    position: relative;
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: #d9d7d1;
    transition: background-color 200ms ease;
  }
  .switch::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.2);
    transition: translate 240ms var(--ease-out);
  }
  .switch[aria-checked="true"] {
    background: #5d50bd;
  }
  .switch[aria-checked="true"]::after {
    translate: 16px 0;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
    margin-top: 18px;
  }
  .status {
    display: grid;
    justify-items: end;
    font-size: 12px;
    color: #8a8894;
  }
  .status > span {
    grid-area: 1 / 1;
    transition: opacity 200ms ease;
  }
  .done,
  .stage[data-published] .draft {
    opacity: 0;
  }
  .stage[data-published] .done {
    opacity: 1;
  }
  .publish {
    padding: 9px 16px;
    border-radius: 9px;
    background: #1d1c22;
    color: #fff;
    font-weight: 500;
  }
  .toast {
    position: absolute;
    top: 58px;
    right: 18px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-radius: 10px;
    background: #1d1c22;
    color: #fff;
    opacity: 0;
    translate: 0 -8px;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.25);
    transition:
      opacity 260ms var(--ease-out),
      translate 260ms var(--ease-out);
  }
  .toast :global(svg) {
    color: #7ee2a8;
  }
  .stage[data-published] .toast {
    opacity: 1;
    translate: 0 0;
  }

  /* Cua's agent cursor: the arrow, its click ticks and the session badge that rests beside it and
     shrinks to a chip while the cursor travels. */
  .cursor {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    will-change: transform;
  }
  .arrow {
    position: absolute;
    top: -5px;
    left: -5px;
    max-width: none;
    filter: drop-shadow(0 0 7px rgb(199 125 255 / 0.65)) drop-shadow(0 2px 3px rgb(0 0 0 / 0.35));
    transform-origin: 5px 5px;
    transition: scale 120ms var(--ease-out);
  }
  .cursor[data-pressed] .arrow {
    scale: 0.86;
  }
  .ticks {
    position: absolute;
    top: -16px;
    left: -16px;
    width: 22px;
    height: 22px;
  }
  .ticks i {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2px;
    height: 7px;
    border-radius: 1px;
    background: #e8b8ff;
    opacity: 0;
    transform-origin: 1px 13px;
  }
  .ticks i:nth-child(1) {
    rotate: -60deg;
  }
  .ticks i:nth-child(2) {
    rotate: -20deg;
  }
  .ticks i:nth-child(3) {
    rotate: 20deg;
  }
  .cursor[data-clicking] .ticks i {
    animation: tick 420ms var(--ease-out);
  }
  @keyframes tick {
    0% {
      opacity: 1;
      translate: -1px -14px;
    }
    100% {
      opacity: 0;
      translate: -1px -20px;
    }
  }
  .badge {
    position: absolute;
    top: 26px;
    left: 6px;
  }
  .chip,
  .pill {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    border-radius: 999px;
    color: #fff;
    background: linear-gradient(90deg, #a888e0, #6e57ad 80%, #4f3f80);
    box-shadow:
      0 0 0 1px rgb(240 210 255 / 0.65),
      0 0 16px rgb(183 124 255 / 0.4),
      0 6px 16px rgb(0 0 0 / 0.35);
    transition:
      opacity 180ms var(--ease-out),
      scale 220ms var(--ease-out),
      filter 180ms ease;
    transform-origin: 14px 14px;
  }
  .chip {
    justify-content: center;
    width: 28px;
    height: 28px;
  }
  .pill {
    gap: 6px;
    height: 32px;
    padding: 0 4px 0 13px;
    font-size: 13px;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .square {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.55) inset;
    background: rgb(255 255 255 / 0.08);
  }
  .square.filled {
    background: #d07be8;
    box-shadow: 0 0 0 1.5px #f6dcff inset;
  }
  .cursor .chip,
  .cursor[data-moving] .pill {
    opacity: 0;
    scale: 0.6;
    filter: blur(2px);
  }
  .cursor[data-moving] .chip {
    opacity: 1;
    scale: 1;
    filter: none;
  }

  .label {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 11px;
    border-radius: 999px;
    background: rgb(14 14 15 / 0.7);
    box-shadow: 0 0 0 1px var(--line-strong) inset;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    font-size: 12px;
    color: var(--ink-80);
  }
  .label i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  .toggle {
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 4;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: rgb(14 14 15 / 0.7);
    box-shadow: 0 0 0 1px var(--line-strong) inset;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: var(--ink);
    cursor: pointer;
    transition: transform 160ms var(--ease-out);
  }
  .toggle:active {
    transform: scale(0.94);
  }
  .toggle > :global(svg) {
    grid-area: 1 / 1;
  }
  .toggle[data-playing="true"] :global(.play-icon),
  .toggle[data-playing="false"] :global(.pause-icon) {
    display: none;
  }
  .stage[data-static] ~ .toggle {
    display: none;
  }
</style>
