---
import type { Point } from "../content/site";
import Icon from "./Icon.astro";

interface Props {
  points: ReadonlyArray<Point>;
}

const { points } = Astro.props;
---

<ul class="points">
  {
    points.map((point) => (
      <li>
        <Icon name={point.icon} size={19} class="icon" />
        <h3>{point.title}</h3>
        <p>{point.body}</p>
      </li>
    ))
  }
</ul>

<style>
  .points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    align-content: start;
    gap: 10px;
  }
  li :global(.icon) {
    margin-bottom: 4px;
    color: var(--accent);
  }
  h3 {
    font-size: 16px;
    font-weight: 500;
  }
  p {
    font-size: 14.5px;
    line-height: 1.62;
    color: var(--ink-60);
  }
  @media (max-width: 820px) {
    .points {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
