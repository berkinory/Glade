---
import { Picture } from "astro:assets";
import appChat from "../assets/images/app-chat.png";
import horizon from "../assets/images/art-horizon.webp";
import { hero, REPO_URL } from "../content/site";
import Icon from "./Icon.astro";
import BrewCommand from "./BrewCommand.astro";
import DownloadMenu from "./DownloadMenu.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="art">
    <Picture
      src={horizon}
      alt="Engraving of a misty valley at dawn, with a classical temple on a hill and cypress trees."
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality={58}
    />
  </div>

  <div class="copy container">
    <h1 id="hero-title" class="serif-title rise" style="--d: 0ms">
      {hero.title[0]} <br />
      {hero.title[1]}
    </h1>
    <p class="lede rise" style="--d: 70ms">{hero.lead}</p>
    <div class="ctas rise" style="--d: 140ms">
      <DownloadMenu />
      <BrewCommand />
    </div>
    <a class="star rise" style="--d: 210ms" href={REPO_URL}>
      <Icon name="github" size={14} />
      <span>Star on GitHub</span>
    </a>
  </div>

  <div class="stage">
    <div class="glow" aria-hidden="true"></div>
    <figure class="window">
      <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
      <Picture
        src={appChat}
        alt="The Glade window: projects and chats from several agents in the sidebar, Claude answering with a bar chart of lines of code per package, and the Environment panel showing the branch, local servers, usage and editor."
        formats={["avif", "webp"]}
      fallbackFormat="webp"
        widths={[480, 720, 960, 1200, 1800, 2400]}
        sizes="(max-width: 1240px) calc(100vw - 40px), 1200px"
        priority
        quality={70}
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: clamp(132px, 16vw, 196px);
  }
  .art {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: min(1000px, 120vw);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 30%, transparent 78%);
    mask-image: linear-gradient(to bottom, #000 30%, transparent 78%);
  }
  .art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
    opacity: 0.42;
  }
  .art::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 46% at 50% 34%, rgb(14 14 15 / 0.62), transparent 70%),
      linear-gradient(to right, var(--bg), transparent 26%, transparent 74%, var(--bg));
  }
  .copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
  }
  h1 {
    font-size: clamp(38px, 10.4vw, 96px);
    line-height: 1;
    letter-spacing: -0.026em;
  }
  .lede {
    max-width: 620px;
    margin-top: 28px;
    font-size: clamp(16.5px, 1.5vw, 18.5px);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    width: 100%;
    margin-top: 40px;
  }
  .star {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 22px;
    padding: 4px 6px;
    font-size: 13px;
    line-height: 1;
    color: var(--ink-60);
    text-decoration: none;
    transition: color 140ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .star:hover {
      color: var(--ink);
    }
  }
  .ctas > :global(*) {
    min-width: 0;
    max-width: 100%;
  }
  /* The platform menu opens over the screenshot below, so the row sits above it. */
  .ctas {
    position: relative;
    z-index: 2;
  }
  .stage {
    position: relative;
    width: min(100% - 40px, 1200px);
    margin: clamp(48px, 6vw, 72px) auto 0;
  }
  .glow {
    position: absolute;
    inset: -12% 6% auto;
    height: 70%;
    z-index: -1;
    background: radial-gradient(50% 50% at 50% 50%, rgb(147 135 224 / 0.14), transparent 70%);
  }
  .window {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: clamp(8px, 1vw, 12px);
    box-shadow:
      0 0 0 1px var(--line-strong),
      0 40px 90px rgb(0 0 0 / 0.7),
      0 2px 6px rgb(0 0 0 / 0.4);
  }
  .window :global(picture),
  .window :global(img) {
    display: block;
    width: 100%;
    border-radius: inherit;
  }
  .lights {
    position: absolute;
    top: 1.85%;
    left: 1.5%;
    display: flex;
    gap: 15.4%;
    width: 4.33%;
  }
  .lights i {
    flex: 1;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #ff5f57;
  }
  .lights i:nth-child(2) {
    background: #febc2e;
  }
  .lights i:nth-child(3) {
    background: #28c840;
  }
  @media (max-width: 720px) {
    .star,
    .ctas > :global(.brew) {
      display: none;
    }
    .art {
      height: 820px;
      -webkit-mask-image: linear-gradient(to bottom, #000 45%, transparent 92%);
      mask-image: linear-gradient(to bottom, #000 45%, transparent 92%);
    }
    .art :global(img) {
      object-position: 58% 0%;
      opacity: 0.5;
    }
    .art::after {
      background: radial-gradient(90% 40% at 50% 36%, rgb(14 14 15 / 0.55), transparent 75%);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .rise {
      animation: rise 900ms var(--ease-out) both;
      animation-delay: var(--d);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
      filter: blur(6px);
    }
  }
</style>
