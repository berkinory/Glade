---
import { chapters } from "../content/site";
import ChapterHeading from "./ChapterHeading.astro";
import ComputerUseDemo from "./ComputerUseDemo.astro";
import PointList from "./PointList.astro";

const chapter = chapters.computer;
---

<section id="computer-use" class="section" aria-labelledby="computer-title">
  <div class="night" aria-hidden="true"></div>
  <div class="container inner">
    <div class="head" data-reveal>
      <ChapterHeading
        id="computer-title"
        numeral={chapter.numeral}
        label={chapter.label}
        title={chapter.title}
      />
      <p class="lede">{chapter.body}</p>
    </div>

    <div data-reveal>
      <ComputerUseDemo caption={chapter.caption} />
    </div>

    <PointList points={chapter.points} />
  </div>
</section>


<style>
  .section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(96px, 11vw, 150px);
    background: var(--bg-night);
  }
  .night {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        to bottom,
        var(--bg-night) 0%,
        rgb(9 9 10 / 0.9) 22%,
        rgb(9 9 10 / 0.45) 50%,
        rgb(9 9 10 / 0.88) 78%,
        var(--bg-night) 100%
      ),
      radial-gradient(70% 50% at 50% 55%, rgb(147 135 224 / 0.08), transparent 70%);
  }
  .inner {
    display: grid;
    gap: clamp(48px, 6vw, 64px);
  }
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 48px;
  }
  .head .lede {
    max-width: 440px;
  }
  @media (max-width: 820px) {
    .head {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }
</style>
