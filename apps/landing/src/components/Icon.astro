---
import {
  AppWindowIcon,
  ArrowDataTransferHorizontalIcon,
  Book02Icon,
  ChartBarLineIcon,
  Copy01Icon,
  CursorInWindowIcon,
  DashboardSpeed01Icon,
  GitForkIcon,
  GithubIcon,
  GitPullRequestIcon,
  Globe02Icon,
  Home01Icon,
  JusticeScale01Icon,
  Key01Icon,
  LaptopIcon,
  Layers01Icon,
  PauseIcon,
  PlayIcon,
  Plug01Icon,
  ShieldKeyIcon,
  Tick02Icon,
  UndoIcon,
  ArrowDown01Icon,
} from "@hugeicons/core-free-icons";
import type { IconName } from "../content/site";

// The app's own Hugeicons set, drawn at build time so pages ship no icon code.
type Glyph = ReadonlyArray<readonly [string, Record<string, string | number>]>;

const glyphs: Record<IconName, Glyph> = {
  chevronDown: ArrowDown01Icon,
  book: Book02Icon,
  chart: ChartBarLineIcon,
  check: Tick02Icon,
  copy: Copy01Icon,
  fork: GitForkIcon,
  gauge: DashboardSpeed01Icon,
  github: GithubIcon,
  globe: Globe02Icon,
  handoff: ArrowDataTransferHorizontalIcon,
  home: Home01Icon,
  key: Key01Icon,
  laptop: LaptopIcon,
  layers: Layers01Icon,
  pause: PauseIcon,
  play: PlayIcon,
  plug: Plug01Icon,
  pointer: CursorInWindowIcon,
  pullRequest: GitPullRequestIcon,
  scale: JusticeScale01Icon,
  shield: ShieldKeyIcon,
  undo: UndoIcon,
  window: AppWindowIcon,
};

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
const toAttribute = (key: string) => key.replace(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`);
const markup = glyphs[name]
  .map(([tag, attributes]) => {
    const pairs = Object.entries(attributes)
      .filter(([key]) => key !== "key")
      .map(([key, value]) => `${toAttribute(key)}="${value}"`)
      .join(" ");
    return `<${tag} ${pairs}/>`;
  })
  .join("");
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
  set:html={markup}
/>
