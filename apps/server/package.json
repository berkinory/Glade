{
  "name": "@glade/cli",
  "version": "0.0.2",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berkinory/Glade.git",
    "directory": "apps/server"
  },
  "bin": {
    "glade": "dist/index.mjs",
    "glade-restore-migration-backup": "dist/restoreMigrationBackup.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "node scripts/cli.ts build",
    "start": "bun dist/index.mjs",
    "prepare": "effect-language-service patch",
    "typecheck": "bun ../../node_modules/@typescript/native/bin/tsc --noEmit --tsBuildInfoFile node_modules/.cache/typescript-native.tsbuildinfo",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.2.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.259",
    "@anthropic-ai/sdk": "^0.100.0",
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@opencode-ai/sdk": "1.18.31",
    "@pierre/diffs": "^1.2.12",
    "@xterm/headless": "^6.0.0",
    "effect": "catalog:",
    "node-pty": "^1.1.0",
    "open": "^10.1.0",
    "tree-kill": "^1.2.2",
    "ws": "^8.21.0",
    "yaml": "^2.8.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@glade/contracts": "workspace:*",
    "@glade/shared": "workspace:*",
    "@glade/web": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "^8.5.13",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.19 || ^23.11 || >=24.10"
  }
}
