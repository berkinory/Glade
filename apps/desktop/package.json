{
  "name": "@glade/desktop",
  "version": "0.2.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/fetch-cua-driver.mjs && bun run scripts/dev.mjs",
    "dev:build": "bun run scripts/start-electron.mjs",
    "build:dev": "bun run build",
    "dev:bundle": "tsdown --watch",
    "dev:electron": "bun run scripts/dev-electron.mjs",
    "build": "node scripts/build-notification-permissions.mjs && node scripts/fetch-cua-driver.mjs && tsdown",
    "start": "bun run scripts/start-electron.mjs",
    "typecheck": "bun ../../node_modules/@typescript/native/bin/tsc --noEmit --tsBuildInfoFile node_modules/.cache/typescript-native.tsbuildinfo",
    "test": "vitest run --passWithNoTests",
    "smoke-test": "bun scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.18.2",
    "@ghostery/adblocker-electron-preload": "2.18.2",
    "@trycua/cua-driver": "0.34.0",
    "effect": "catalog:",
    "electron": "43.5.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@glade/contracts": "workspace:*",
    "@glade/shared": "workspace:*",
    "@types/node": "catalog:",
    "node-api-headers": "^1.9.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wait-on": "^8.0.2"
  },
  "productName": "Glade"
}
